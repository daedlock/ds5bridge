[Unit]
Description=ds5bridge: Bluetooth DualSense %I as a wired controller
Documentation=https://github.com/daedlock/ds5bridge
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=simple
ExecStart=/usr/bin/ds5bridge run --hidraw /dev/%I --hide-physical
ExecStopPost=/usr/bin/ds5bridge hand-back /dev/%I
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
