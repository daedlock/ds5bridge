[Unit]
Description=ds5bridge: Bluetooth DualSense %I as a wired controller
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=simple
Environment=PYTHONPATH=/usr/local/lib/ds5bridge PYTHONUNBUFFERED=1
ExecStartPre=/bin/rm -f /run/ds5bridge/bypass
ExecStart=/usr/bin/python3 -m ds5bridge --hidraw /dev/%I --hide-physical
ExecStopPost=/usr/local/lib/ds5bridge/ds5bridge-restore /dev/%I
Restart=on-failure
RestartSec=1
